# HomeGenie environment template (do not commit secrets)
# Copy to `.env` and fill in values for local development or CI.

# Environment mode — set to "production" to enforce strict secret requirements
ENVIRONMENT=development

# API authentication — REQUIRED in production (no default)
# HOMEGENIE_API_KEY=<generate-a-random-token>

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Postgres configuration (optional - feature-flagged)
# IMPORTANT: Change default credentials before any non-local deployment!
# For a dynamic/global hostname reachable from containers and host, use 'globalone'
POSTGRES_USER=homegenie
POSTGRES_PASSWORD=changeme
POSTGRES_DB=homegenie_db
POSTGRES_HOST=globalone
POSTGRES_PORT=5432
# Example full URL (optional override): postgresql+asyncpg://user:pass@host:5432/db
POSTGRES_URL=postgresql+asyncpg://homegenie:changeme@globalone:5432/homegenie_db

# Feature flags
# Set ENABLE_POSTGRES_MIGRATION=true locally to enable the v2 migration endpoints
ENABLE_POSTGRES_MIGRATION=true
ENABLE_REDIS_BRIDGE=false
ENABLE_ALEXA_BRIDGE=false
ENABLE_GOOGLE_BRIDGE=false
ENABLE_WS_BRIDGE=false

# API dev host/port used by tests and frontend discovery
API_HOST=localhost
API_PORT=8080
API_BASE_URL=http://localhost:8080

# Logging
LOG_LEVEL=INFO

# LLM / Ollama settings
# Set LLM_ENABLED=true and choose a provider to unlock agentic planning
LLM_ENABLED=true
LLM_PROVIDER=ollama

# Ollama (local / host desktop) — default topology
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT=30
PLANNER_TIMEOUT=25

# Google Gemini (cloud) — used when LLM_PROVIDER=google
# GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# Groq (cloud) — used when LLM_PROVIDER=groq
# LLAMA_CLOUD_API_KEY=your_groq_api_key_here
# LLAMA_CLOUD_MODEL=llama-3.1-8b-instant
